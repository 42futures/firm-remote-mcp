# Scaleway deployment
SCW_REGISTRY_ENDPOINT=rg.fr-par.scw.cloud/firm-mcp
SCW_CONTAINER_ID=your-container-uuid
SERVICE_NAME=firm-remote-mcp

# Server
SERVER_URL=http://localhost:8080
PORT=8080
RUST_LOG=info
# WORKSPACE_SUBDIR=data (optional, default: .)

# OAuth
OAUTH_CLIENT_ID=my-mcp-client
OAUTH_CLIENT_SECRET=some-long-secret
ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
JWT_SIGNING_KEY=some-random-key-for-local-dev

# Git
REPO_URL=https://code.eigin.ai/group/repo.git
BRANCH=mcp
GIT_TOKEN=glpat-...
