# GCloud deployment
PROJECT_ID=your-gcp-project
# REGION=europe-north1 (optional, default: europe-west1)

# Server
SERVER_URL=http://localhost:8080
PORT=8080
RUST_LOG=info
# WORKSPACE_SUBDIR=data (optional, default: .)

# OAuth
OAUTH_CLIENT_ID=my-mcp-client
OAUTH_CLIENT_SECRET=some-long-secret
ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
JWT_SIGNING_KEY=some-random-key-for-local-dev

# Git
REPO_URL=https://github.com/42futures/firm-workspace.git
BRANCH=mcp
GITHUB_TOKEN=github_pat_...
